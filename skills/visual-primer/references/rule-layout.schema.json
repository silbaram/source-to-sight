{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "kind", "ruleIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,95}$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"enum": ["comparison", "conditions", "states"]},
          "ruleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "transitionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "comparison"}}}, "then": {"properties": {"ruleIds": {"minItems": 2}}}},
          {"if": {"properties": {"kind": {"const": "states"}}}, "then": {"required": ["transitionIds"]}, "else": {"not": {"required": ["transitionIds"]}}}
        ]
      }
    }
  }
}
