{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 2},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "kind", "ruleIds", "html"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,95}$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"const": "authored"},
          "ruleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "claimIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "html": {"type": "string", "minLength": 1},
          "css": {"type": "string"},
          "script": {"type": "string"}
        }
      }
    }
  }
}
